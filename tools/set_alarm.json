{
  "package_name": "com.jarvisos.system",
  "app_label": "JarvisOS System",
  "receiver_class": "@system/set_alarm",
  "tool_name": "set_alarm",
  "description": "Set an alarm for a specific time using the device's default clock app",
  "params": [
    {"name": "hour",   "type": "integer", "required": true,  "description": "Hour in 24-hour format (0-23)"},
    {"name": "minute", "type": "integer", "required": true,  "description": "Minute (0-59)"},
    {"name": "label",  "type": "string",  "required": false, "description": "Optional alarm label"}
  ]
}
