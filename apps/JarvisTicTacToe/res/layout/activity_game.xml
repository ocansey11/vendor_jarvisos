<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls so that the controls stay reachable on a small screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <!-- Title, and the rules behind the info button. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/rules"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/rules"
            android:text="ⓘ"
            android:textColor="@color/text"
            android:textSize="24sp" />
    </FrameLayout>

    <!-- Who plays which mark, during a game. -->
    <TextView
        android:id="@+id/players"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <!-- Game controls, at the top so they never scroll away under a long speech bubble. -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/new_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_game" />
        <Button
            android:id="@+id/pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/pause" />
    </LinearLayout>
    <!-- Jarvis's say() lines. -->
    <TextView
        android:id="@+id/bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:background="@drawable/bubble"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/bubble_text"
        android:textSize="15sp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/thinking_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true" />
        <TextView
            android:id="@+id/thinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="18sp" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="3"
        android:rowCount="3">
        <Button android:id="@+id/cell0" style="@style/Cell" android:contentDescription="cell 0" />
        <Button android:id="@+id/cell1" style="@style/Cell" android:contentDescription="cell 1" />
        <Button android:id="@+id/cell2" style="@style/Cell" android:contentDescription="cell 2" />
        <Button android:id="@+id/cell3" style="@style/Cell" android:contentDescription="cell 3" />
        <Button android:id="@+id/cell4" style="@style/Cell" android:contentDescription="cell 4" />
        <Button android:id="@+id/cell5" style="@style/Cell" android:contentDescription="cell 5" />
        <Button android:id="@+id/cell6" style="@style/Cell" android:contentDescription="cell 6" />
        <Button android:id="@+id/cell7" style="@style/Cell" android:contentDescription="cell 7" />
        <Button android:id="@+id/cell8" style="@style/Cell" android:contentDescription="cell 8" />
    </GridLayout>


</LinearLayout>
</ScrollView>
