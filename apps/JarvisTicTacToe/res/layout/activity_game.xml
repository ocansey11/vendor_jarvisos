<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/title"
        android:textColor="@color/text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Jarvis's say() lines. -->
    <TextView
        android:id="@+id/bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="56dp"
        android:background="@drawable/bubble"
        android:padding="14dp"
        android:textColor="@color/bubble_text"
        android:textSize="17sp"
        android:visibility="invisible" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="3"
        android:rowCount="3">
        <Button android:id="@+id/cell0" style="@style/Cell" android:contentDescription="cell 0" />
        <Button android:id="@+id/cell1" style="@style/Cell" android:contentDescription="cell 1" />
        <Button android:id="@+id/cell2" style="@style/Cell" android:contentDescription="cell 2" />
        <Button android:id="@+id/cell3" style="@style/Cell" android:contentDescription="cell 3" />
        <Button android:id="@+id/cell4" style="@style/Cell" android:contentDescription="cell 4" />
        <Button android:id="@+id/cell5" style="@style/Cell" android:contentDescription="cell 5" />
        <Button android:id="@+id/cell6" style="@style/Cell" android:contentDescription="cell 6" />
        <Button android:id="@+id/cell7" style="@style/Cell" android:contentDescription="cell 7" />
        <Button android:id="@+id/cell8" style="@style/Cell" android:contentDescription="cell 8" />
    </GridLayout>

    <LinearLayout
        android:id="@+id/thinking_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true" />
        <TextView
            android:id="@+id/thinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text"
        android:textSize="18sp" />

    <Button
        android:id="@+id/play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/play" />

    <Switch
        android:id="@+id/evaluate_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="@string/evaluate_switch"
        android:textColor="@color/text" />
</LinearLayout>
