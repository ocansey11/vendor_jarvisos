// ObjectBox prebuilt libraries for JarvisOS

// Core ObjectBox Java library plus the two artifacts its POM depends on:
//   objectbox-java-api — the annotations (@Entity, @Id, ...)
//   greenrobot essentials — collections/IO helpers BoxStore uses at runtime
// (its third dependency, jsr305, comes from the platform's own module.)
java_import {
    name: "objectbox-java",
    jars: [
        "lib/java/objectbox-java-4.0.3.jar",
        "lib/java/objectbox-java-api-4.0.3.jar",
        "lib/java/essentials-3.1.0.jar",
    ],
    sdk_version: "current",
}

// ObjectBox Android wrapper
java_import {
    name: "objectbox-android",
    jars: ["lib/java/objectbox-android.jar", "lib/java/objectbox-java-4.0.3.jar"],
    sdk_version: "current",
}

// Native JNI library
cc_prebuilt_library_shared {
    name: "libobjectbox-jni",
    target: {
        android_arm64: {
            srcs: ["lib/jni/arm64-v8a/libobjectbox-jni.so"],
        },
        // For the x86_64 emulator.
        android_x86_64: {
            srcs: ["lib/jni/x86_64/libobjectbox-jni.so"],
            // The emulator product asks for 16K-aligned ELF segments; this
            // prebuilt is 4K-aligned, which is fine on its 4K-page kernel.
            ignore_max_page_size: true,
        },
    },
    shared_libs: ["liblog"],
    strip: {
        none: true,
    },
}
